---
import Layout from "../../layouts/Layout.astro";
import Body from "../../sections/ProjectDetailBody.astro";
import t from "../../i18n/es/index.ts";
import projects from "../../data/projects";

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
---

<Layout
  locale="es"
  t={t}
  current="project"
  title={`${project.name}: ${project.tagline.es} · Nicolás Ramos`}
  description={project.body.es[0]}
>
  <Body project={project} locale="es" t={t} />
</Layout>
