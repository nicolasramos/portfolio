---
import Layout from "../../../layouts/Layout.astro";
import Body from "../../../sections/ProjectDetailBody.astro";
import t from "../../../i18n/en/index.ts";
import projects from "../../../data/projects";

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
---

<Layout
  locale="en"
  t={t}
  current="project"
  title={`${project.name}: ${project.tagline.en} · Nicolás Ramos`}
  description={project.body.en[0]}
>
  <Body project={project} locale="en" t={t} />
</Layout>
