---
import Reveal from "./Reveal.astro";

type Props = {
  items: readonly { q: string; a: string }[];
};

const { items } = Astro.props;
---

<div class="mt-8 grid gap-3 md:grid-cols-2">
  {
    items.map((item, index) => (
      <Reveal delay={index * 60} class="h-full">
        <details class="group h-full rounded-2xl border border-line bg-panel p-6 transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] hover:border-line-strong open:border-line-strong">
          <summary class="flex cursor-pointer list-none items-start justify-between gap-4 text-lg font-semibold marker:hidden">
            <span>{item.q}</span>
            <span class="mt-1 font-mono text-lg text-accent transition-transform duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] group-open:rotate-45" aria-hidden="true">
              +
            </span>
          </summary>
          <p class="mt-4 text-base text-muted">{item.a}</p>
        </details>
      </Reveal>
    ))
  }
</div>
