---
import Reveal from "./Reveal.astro";

type Props = {
  eyebrow?: string;
  title?: string;
  intro?: string;
  id?: string;
  level?: 1 | 2;
  class?: string;
};

const { eyebrow, title, intro, id, level = 2, class: className } = Astro.props;
const Heading: any = level === 1 ? "h1" : "h2";
---

<section id={id} class:list={["mx-auto max-w-6xl px-6", className]}>
  {
    (eyebrow || title || intro) && (
      <Reveal class="max-w-[680px]">
        {eyebrow && <p class="label-mono">{eyebrow}</p>}
        {title && (
          <Heading
            class:list={[
              "mt-3 font-semibold tracking-tight",
              level === 1 ? "text-4xl sm:text-5xl" : "text-3xl sm:text-4xl",
            ]}
          >
            {title}
          </Heading>
        )}
        {intro && <p class="mt-4 text-lg text-muted">{intro}</p>}
      </Reveal>
    )
  }
  <slot />
</section>
