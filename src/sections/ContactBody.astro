---
import type { Locale } from "../data/site";
import { contact } from "../data/site";
import Reveal from "../components/Reveal.astro";
import Section from "../components/Section.astro";
import Icons from "../components/Icons.astro";

type Props = { locale: Locale; t: Record<string, any> };
const { locale, t } = Astro.props;

const mailto = `mailto:${contact.email}?subject=${encodeURIComponent(t.contact.mailSubject)}&body=${encodeURIComponent(t.contact.mailBody)}`;
---

<Section eyebrow={t.contact.eyebrow} title={t.contact.title} intro={t.contact.intro} class="pt-8" level={1}>
  <div class="mt-8 grid gap-3 lg:grid-cols-3">
    <Reveal class="rounded-2xl border border-line bg-panel p-6 lg:col-span-2">
      <h2 class="text-xl font-semibold">{t.contact.emailLabel}</h2>
      <p data-email class="mt-4 break-all font-mono text-2xl text-accent">{contact.email}</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={mailto} class="inline-flex items-center gap-2 rounded-full bg-accent px-3 py-2 text-base font-semibold text-black transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] hover:bg-white/80 active:scale-[0.98]">
          <Icons name="mail" class="h-4 w-4" />
          {t.finalCta.primary}
        </a>
        <button
          type="button"
          data-copy
          data-label={t.contact.copyLabel}
          data-done={t.contact.copiedLabel}
          class="inline-flex items-center gap-2 rounded-full border border-line px-3 py-2 text-base font-semibold transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] hover:border-line-strong active:scale-[0.98]"
        >
          <Icons name="copy" class="h-4 w-4" />
          <span data-copy-label>{t.contact.copyLabel}</span>
        </button>
      </div>
      <p class="mt-6 max-w-[680px] text-sm text-muted">{t.contact.formNote}</p>
    </Reveal>

    <Reveal delay={80} class="rounded-2xl border border-line bg-panel p-6">
      <h2 class="label-mono">{t.contact.availability.title}</h2>
      <ul class="mt-4 space-y-3">
        {
          t.contact.availability.items.map((item: string) => (
            <li class="flex items-start gap-3 text-sm text-muted">
              <Icons name="check" class="mt-1 h-4 w-4 shrink-0 text-accent" />
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </Reveal>
  </div>

  <Reveal delay={140} class="mt-3">
    <h2 class="label-mono">{t.contact.linksTitle}</h2>
    <ul class="mt-4 grid gap-3 sm:grid-cols-3">
      <li>
        <a href={contact.github} rel="me noopener" class="flex items-center justify-between gap-4 rounded-2xl border border-line bg-panel p-6 transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] hover:-translate-y-2 hover:border-line-strong">
          <span class="text-base font-semibold">{t.footer.github}</span>
          <Icons name="github" class="h-5 w-5 text-muted" />
        </a>
      </li>
      <li>
        <a href={contact.linkedin} rel="me noopener" class="flex items-center justify-between gap-4 rounded-2xl border border-line bg-panel p-6 transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] hover:-translate-y-2 hover:border-line-strong">
          <span class="text-base font-semibold">LinkedIn</span>
          <Icons name="linkedin" class="h-5 w-5 text-muted" />
        </a>
      </li>
      <li>
        <a href={contact.blog} rel="noopener" class="flex items-center justify-between gap-4 rounded-2xl border border-line bg-panel p-6 transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] hover:-translate-y-2 hover:border-line-strong">
          <span class="text-base font-semibold">nramos.dev</span>
          <Icons name="arrow" class="h-5 w-5 text-muted" />
        </a>
      </li>
    </ul>
  </Reveal>
</Section>

<script>
  const button = document.querySelector<HTMLButtonElement>("[data-copy]");
  if (button) {
    const label = button.querySelector<HTMLElement>("[data-copy-label]");
    const email = document.querySelector<HTMLElement>("[data-email]")?.textContent?.trim() ?? "";
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(email);
      } catch {
        const helper = document.createElement("textarea");
        helper.value = email;
        document.body.appendChild(helper);
        helper.select();
        document.execCommand("copy");
        helper.remove();
      }
      if (label) label.textContent = button.dataset.done ?? "";
      window.setTimeout(() => {
        if (label) label.textContent = button.dataset.label ?? "";
      }, 2000);
    });
  }
</script>
