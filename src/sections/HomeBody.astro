---
import type { Locale } from "../data/site";
import paths from "../data/site";
import projects from "../data/projects";
import Reveal from "../components/Reveal.astro";
import Section from "../components/Section.astro";
import Icons from "../components/Icons.astro";
import TaglineReveal from "../components/TaglineReveal.astro";
import TerminalPanel from "../components/TerminalPanel.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Faq from "../components/Faq.astro";

type Props = { locale: Locale; t: Record<string, any> };
const { locale, t } = Astro.props;
const p = paths[locale];
const top = projects.slice(0, 3);

const btn =
  "inline-flex items-center gap-2 rounded-full px-3 py-2 text-base font-semibold transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] active:scale-[0.98]";
---

<section class="mx-auto grid max-w-6xl items-center gap-8 px-6 pb-20 pt-8 lg:grid-cols-2 lg:gap-16">
  <div>
    <Reveal>
      <p class="label-mono">{t.hero.eyebrow}</p>
    </Reveal>
    <Reveal delay={80}>
      <h1 class="hero-ink mt-4 max-w-[680px] text-5xl font-semibold leading-[1] tracking-tight sm:text-6xl">
        {t.hero.title.map((line: string) => (<span class="block">{line}</span>))}
      </h1>
    </Reveal>
    <Reveal delay={160}>
      <p class="mt-6 max-w-[680px] text-lg text-muted">{t.hero.subtitle}</p>
    </Reveal>
    <Reveal delay={240}>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href={p.contact} class:list={[btn, "bg-accent text-black hover:bg-ink"]}>
          {t.hero.primary}
          <Icons name="arrow" class="h-4 w-4" />
        </a>
        <a href={p.projects} class:list={[btn, "border border-line text-ink hover:border-line-strong"]}>
          {t.hero.secondary}
        </a>
      </div>
    </Reveal>
    <Reveal delay={320}>
      <p class="mt-6 font-mono text-xs uppercase tracking-widest text-muted">{t.hero.proof}</p>
    </Reveal>
  </div>
  <div>
    <TerminalPanel labels={t.projectsSection} />
  </div>
</section>

<section class="border-y border-line bg-panel">
  <ul class="mx-auto grid max-w-6xl grid-cols-2 gap-px md:grid-cols-4">
    {
      t.proof.items.map((item: any, index: number) => (
        <Reveal as="li" delay={index * 70} class="px-6 py-8">
          <p class="font-mono text-3xl font-semibold text-accent">{item.value}</p>
          <p class="mt-2 text-sm text-muted">{item.label}</p>
        </Reveal>
      ))
    }
  </ul>
</section>

<Section eyebrow={t.services.eyebrow} title={t.services.title} intro={t.services.intro} class="pt-24">
  <div class="mt-8 grid gap-3 md:grid-cols-2">
    {
      t.services.items.map((item: any, index: number) => (
        <Reveal delay={index * 70} class="h-full rounded-2xl border border-line bg-panel p-6 transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] hover:-translate-y-2 hover:border-line-strong">
          <h3 class="text-xl font-semibold">{item.title}</h3>
          <p class="mt-3 text-base text-muted">{item.body}</p>
          <ul class="mt-6 space-y-3">
            {item.points.map((point: string) => (
              <li class="flex items-start gap-3 text-sm text-muted">
                <Icons name="check" class="mt-1 h-4 w-4 shrink-0 text-accent" />
                <span>{point}</span>
              </li>
            ))}
          </ul>
        </Reveal>
      ))
    }
  </div>
  <Reveal class="mt-8">
    <a href={p.services} class="inline-flex items-center gap-2 text-base font-semibold text-accent hover:text-ink">
      {t.finalCta.secondary}
      <Icons name="arrow" class="h-4 w-4" />
    </a>
  </Reveal>
</Section>

<TaglineReveal text={t.tagline.text} />

<Section eyebrow={t.projectsSection.eyebrow} title={t.projectsSection.title} intro={t.projectsSection.intro} class="pt-24">
  <div class="mt-8 grid gap-3 md:grid-cols-3">
    {top.map((project, index) => (
      <ProjectCard project={project} locale={locale} t={t} delay={index * 70} />
    ))}
  </div>
  <Reveal class="mt-8 flex flex-wrap items-center gap-6">
    <a href={p.projects} class="inline-flex items-center gap-2 text-base font-semibold text-accent hover:text-ink">
      {t.projectsSection.cta}
      <Icons name="arrow" class="h-4 w-4" />
    </a>
    <span class="font-mono text-xs uppercase tracking-widest text-muted">{t.projectsSection.total}</span>
  </Reveal>
</Section>

<Section eyebrow={t.process.eyebrow} title={t.process.title} intro={t.process.intro} class="pt-24">
  <ol class="mt-8 grid gap-3 md:grid-cols-3">
    {
      t.process.steps.map((step: any, index: number) => (
        <Reveal as="li" delay={index * 70} class="rounded-2xl border border-line bg-panel p-6">
          <p class="font-mono text-sm text-accent">{step.n}</p>
          <h3 class="mt-4 text-xl font-semibold">{step.title}</h3>
          <p class="mt-3 text-base text-muted">{step.body}</p>
        </Reveal>
      ))
    }
  </ol>
</Section>

<Section eyebrow={t.faq.eyebrow} title={t.faq.title} class="pt-24">
  <Faq items={t.faq.items} />
</Section>

<section class="mx-auto max-w-6xl px-6 pt-24">
  <Reveal class="rounded-2xl border border-line bg-raised p-8 sm:p-16">
    <h2 class="max-w-[680px] text-4xl font-semibold leading-tight tracking-tight">{t.finalCta.title}</h2>
    <p class="mt-4 max-w-[680px] text-lg text-muted">{t.finalCta.body}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href={p.contact} class:list={[btn, "bg-accent text-black hover:bg-ink"]}>
        {t.finalCta.primary}
        <Icons name="arrow" class="h-4 w-4" />
      </a>
      <a href={p.services} class:list={[btn, "border border-line text-ink hover:border-line-strong"]}>
        {t.finalCta.secondary}
      </a>
    </div>
  </Reveal>
</section>
